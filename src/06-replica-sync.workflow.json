{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Replica Sync",
    "quality_profile": "showcase",
    "views": [
      { "id": "happy-path", "label": "Chain-first sync", "focus": ["snapshot", "read_chain", "fetch_peaks", "verify", "traverse", "fetch_nodes", "confirm"], "note": "The trusted root comes from the chain, so every fetched byte is verifiable." },
      { "id": "untrusted-sources", "label": "Untrusted sources", "focus": ["peak_source", "node_source", "verify", "mismatch"], "note": "Any data holder may serve; a bad source is detected, not trusted." },
      { "id": "payment", "label": "Payment", "focus": ["confirm", "payment"], "note": "A confirmed sync is paid per confirmation from the funded sync balance." }
    ]
  },
  "lanes": [
    { "id": "chain", "label": "Chain" },
    { "id": "replica", "label": "Replica Node" },
    { "id": "sources", "label": "Data Sources" },
    { "id": "recovery", "label": "Recovery", "variant": "exception" }
  ],
  "phases": [
    { "id": "anchor", "label": "Trusted root", "fromCol": 0, "toCol": 1 },
    { "id": "walk", "label": "Verify and walk", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "settle", "label": "Fetch and confirm", "fromCol": 4, "toCol": 5 }
  ],
  "mainPath": ["read_chain", "fetch_peaks", "verify", "traverse", "fetch_nodes", "confirm"],
  "nodes": [
    { "id": "snapshot", "lane": "chain", "col": 0, "type": "database", "label": "Bucket Snapshot", "sublabel": "mmr_root, leaf_count", "width": 140 },
    { "id": "payment", "lane": "chain", "col": 5, "type": "database", "label": "Sync Payment", "sublabel": "from sync_balance", "width": 140 },
    { "id": "read_chain", "lane": "replica", "col": 0, "type": "backend", "label": "Read Chain State", "sublabel": "runtime API", "width": 140 },
    { "id": "fetch_peaks", "lane": "replica", "col": 1, "type": "backend", "label": "Fetch Peaks", "sublabel": "GET /mmr_peaks", "width": 140 },
    { "id": "verify", "lane": "replica", "col": 2, "type": "security", "label": "Verify Peaks", "sublabel": "hash(peaks) == root", "width": 140 },
    { "id": "traverse", "lane": "replica", "col": 3, "type": "backend", "label": "Top-Down Walk", "sublabel": "skip matching subtrees", "width": 140 },
    { "id": "fetch_nodes", "lane": "replica", "col": 4, "type": "backend", "label": "Fetch Missing Nodes", "sublabel": "verify each hash", "width": 140 },
    { "id": "confirm", "lane": "replica", "col": 5, "type": "backend", "label": "Confirm Sync", "sublabel": "confirm_replica_sync(roots)", "width": 150 },
    { "id": "peak_source", "lane": "sources", "col": 1, "type": "cloud", "label": "Any Data Holder", "sublabel": "primary, replica, pusher", "width": 150 },
    { "id": "node_source", "lane": "sources", "col": 4, "type": "cloud", "label": "Node Source", "sublabel": "POST /fetch_nodes", "width": 140 },
    { "id": "mismatch", "lane": "recovery", "col": 2, "type": "security", "label": "Peak Mismatch", "sublabel": "source rejected", "width": 140 }
  ],
  "edges": [
    { "id": "trusted-root", "from": "snapshot", "to": "read_chain", "label": "trusted root", "variant": "emphasis" },
    { "id": "start-sync", "from": "read_chain", "to": "fetch_peaks", "role": "main" },
    { "id": "peaks-served", "from": "peak_source", "to": "fetch_peaks", "label": "peaks", "variant": "dashed" },
    { "id": "check-peaks", "from": "fetch_peaks", "to": "verify", "role": "main", "variant": "security" },
    { "id": "peaks-ok", "from": "verify", "to": "traverse", "label": "root matches", "role": "main", "variant": "emphasis" },
    { "id": "peaks-bad", "from": "verify", "to": "mismatch", "label": "hash mismatch", "role": "error", "variant": "security" },
    { "id": "retry-source", "from": "mismatch", "to": "fetch_peaks", "label": "try another holder", "role": "branch", "variant": "dashed" },
    { "id": "walk-down", "from": "traverse", "to": "fetch_nodes", "label": "missing hashes", "role": "main" },
    { "id": "nodes-served", "from": "node_source", "to": "fetch_nodes", "label": "nodes", "variant": "dashed" },
    { "id": "sync-done", "from": "fetch_nodes", "to": "confirm", "label": "all verified", "role": "main", "variant": "emphasis" },
    { "id": "paid", "from": "confirm", "to": "payment", "label": "per-sync payment", "role": "return" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Chain first", "items": ["The replica takes the root from the chain, never from a provider", "Peaks are checked against that root before any traversal", "A lying source is detected at the first hash comparison"] },
    { "dot": "emerald", "title": "Why top-down", "items": ["A matching hash skips the whole subtree", "Unchanged subtrees are deduplicated at the first node", "Sync state is just the set of missing nodes, so it resumes"] },
    { "dot": "amber", "title": "Confirmation and liability", "items": ["Confirmation signs roots for 7 positions: current plus prime-interval history", "The history window avoids racing a fresh checkpoint", "A confirmed root makes the replica challengeable by anyone"] }
  ]
}
