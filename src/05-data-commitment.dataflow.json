  "cards": [
    {
      "dot": "cyan",
      "title": "Content addressing",
      "items": [
        "Chunks and internal nodes are both addressed by hash",
        "Upload is bottom-up: children must exist before the parent",
        "If the root hash exists, the whole tree is present"
      ]
    },
    {
      "dot": "emerald",
      "title": "One MMR per bucket",
      "items": [
        "The MMR is per bucket, not per provider; every provider converges to it",
        "start_seq rises when history is purged; frozen buckets pin it",
        "The snapshot records which primaries signed the state"
      ]
    },
    {
      "dot": "rose",
      "title": "What a proof must show",
      "items": [
        "chunk_proof: the chunk sits in the leaf's data_root",
        "mmr_proof: the leaf sits in the committed mmr_root",
        "Both must verify, or the provider is slashed for InvalidProof"
      ]
    }
  ]
