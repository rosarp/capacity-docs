{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Provider Registration Lifecycle",
    "quality_profile": "showcase",
    "viewBox": [
      1000,
      700
    ],
    "views": [
      {
        "id": "main-path",
        "label": "Registration to exit",
        "focus": [
          "unregistered",
          "registered",
          "serving",
          "idle",
          "deregistered"
        ],
        "note": "The ordered path from staking in to releasing the stake."
      },
      {
        "id": "two-step-exit",
        "label": "Two-step exit",
        "focus": [
          "idle",
          "announced",
          "deregistered"
        ],
        "note": "Announcement freezes new work; completion waits out the window and any open challenge."
      },
      {
        "id": "slash-path",
        "label": "Slash path",
        "focus": [
          "serving",
          "slashed",
          "removed"
        ],
        "note": "A failed challenge ends the registration through the slash path, not the exit path."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Provider registration"
    },
    {
      "id": "gates",
      "label": "Exit and slash"
    },
    {
      "id": "terminal",
      "label": "Cleanup"
    }
  ],
  "states": [
    {
      "id": "unregistered",
      "type": "start",
      "label": "Unregistered",
      "sublabel": "no stake held",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "registered",
      "type": "active",
      "label": "Registered",
      "sublabel": "stake held",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "accepting"
    },
    {
      "id": "serving",
      "type": "active",
      "label": "Serving",
      "sublabel": "committed_bytes > 0",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "slashable"
    },
    {
      "id": "idle",
      "type": "active",
      "label": "Idle",
      "sublabel": "committed_bytes == 0",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "deregistered",
      "type": "success",
      "label": "Deregistered",
      "sublabel": "stake released",
      "lane": "main",
      "col": 4,
      "step": "05"
    },
    {
      "id": "announced",
      "type": "waiting",
      "label": "Exit Announced",
      "sublabel": "accepting flags off",
      "lane": "gates",
      "col": 1,
      "tag": "still slashable"
    },
    {
      "id": "slashed",
      "type": "failure",
      "label": "Slashed",
      "sublabel": "full stake taken",
      "lane": "gates",
      "col": 0,
      "tag": "failed challenge"
    },
    {
      "id": "removed",
      "type": "neutral",
      "label": "Removed",
      "sublabel": "payment back to owner",
      "lane": "terminal",
      "col": 0
    }
  ],
  "transitions": [
    {
      "id": "register",
      "from": "unregistered",
      "to": "registered",
      "label": "register_provider(stake)",
      "labelDy": -25
    },
    {
      "id": "first-agreement",
      "from": "registered",
      "to": "serving",
      "label": "terms redeemed",
      "labelDy": -25
    },
    {
      "id": "agreements-expire",
      "from": "serving",
      "to": "idle",
      "label": "agreements expired",
      "labelDy": -25
    },
    {
      "id": "announce",
      "from": "idle",
      "to": "announced",
      "label": "deregister_provider",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    },
    {
      "id": "complete",
      "from": "announced",
      "to": "deregistered",
      "label": "complete_deregister",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "slash",
      "from": "serving",
      "to": "slashed",
      "label": "no or invalid response",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    },
    {
      "id": "cleanup",
      "from": "slashed",
      "to": "removed",
      "label": "remove_slashed",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Entry",
      "items": [
        "Stake must be at least MinProviderStake and leaves the existential deposit spendable",
        "Stake only grows through add_stake; withdrawal goes through deregistration",
        "Capacity is bounded by stake: max_capacity * MinStakePerByte"
      ]
    },
    {
      "dot": "amber",
      "title": "Two-step exit",
      "items": [
        "Announcement requires committed_bytes == 0 and freezes the accepting flags",
        "complete_deregister waits out DeregisterAnnouncementPeriod, which exceeds ChallengeTimeout",
        "It also requires PendingChallenges == 0, so stake stays slashable to the end",
        "cancel_deregister clears the announcement and restores the accepting flags"
      ]
    },
    {
      "dot": "rose",
      "title": "Slash path",
      "items": [
        "One failed challenge slashes the entire stake, not just this bucket's share",
        "remove_slashed is permissionless and returns remaining payment to the agreement owner",
        "Recorded challenge counters are per provider and tier-independent"
      ]
    }
  ]
}