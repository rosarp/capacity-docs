  "cards": [
    {
      "dot": "cyan",
      "title": "One call, no round trip",
      "items": [
        "The provider authors and signs the terms off-chain",
        "The owner submits the signed quote on-chain in a single extrinsic",
        "There is no on-chain request and accept handshake"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the quote fixes",
      "items": [
        "Price per byte, quota, duration and a valid_until expiry",
        "A primary quote carries bucket_id = None; the bucket is created at redemption",
        "A replica quote carries bucket_id = Some and replica_params"
      ]
    },
    {
      "dot": "amber",
      "title": "Binding both ways",
      "items": [
        "No early exit for the provider and no early cancellation for the owner",
        "Escrow sits on the agreement owner; anyone may top it up",
        "Extensions can be refused later with set_extensions_blocked"
      ]
    }
  ]
}