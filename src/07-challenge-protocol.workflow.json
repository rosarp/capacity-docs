  "cards": [
    {
      "dot": "cyan",
      "title": "Three ways to challenge",
      "items": [
        "A challenge is the last resort after the provider ignores off-chain requests",
        "challenge_checkpoint uses the on-chain snapshot: best for cold buckets",
        "challenge_offchain uses a held provider signature: best for hot buckets",
        "challenge_replica uses the replica's own last_synced_root"
      ]
    },
    {
      "dot": "amber",
      "title": "Who pays the response fee",
      "items": [
        "Authorized accounts (members and agreement owners) get a split; their share never drops below 50%",
        "The general public pays 100%, so an honest provider loses no money",
        "Faster responses cost the provider less: 10% at block 1, 50% from block 96"
      ]
    },
    {
      "dot": "rose",
      "title": "Three valid defences",
      "items": [
        "Proof: the chunk sits in the leaf and the leaf in the committed root",
        "Deleted: an admin-signed newer commitment purged the challenged leaf",
        "Superseded: a newer canonical snapshot still covers the challenged leaf"
      ]
    }
  ]
}